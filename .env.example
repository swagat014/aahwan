# ========================================================
# AAHWAN SPORTS FESTIVAL — ENVIRONMENT VARIABLES
# ========================================================
# Copy this file to '.env.local' to customize local settings.
# NOTE: '.env.local' is already in .gitignore and will NEVER be committed to Git.

# Supabase Configuration (Optional for cloud storage)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional Custom Admin Credentials
# If provided, these will override default secure hash authentication:
# VITE_ADMIN_USERNAME=your_custom_admin_id
# VITE_ADMIN_PASSWORD=your_custom_password
